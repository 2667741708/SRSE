index 0000000..dc6d004
--- /dev/null
+++ b/utils_plus/nse_reliable_split.py
@@ -0,0 +1,103 @@
+import torch
+import torch.nn.functional as F
+
+
+def _normalize_rows(x, eps=1e-12):
+    return x / (x.sum(dim=1, keepdim=True) + eps)
+
+
+@torch.no_grad()
+def _chunked_knn_votes(features, source_prior, args):
+    """SRSE-style topology/source anchored propagation used only for splitting.
+
+    This function does not modify the candidate source. It uses the native
+    candidate distribution as neighbour evidence and returns a propagated
+    distribution for per-class reliable selection.
+    """
+    n = features.shape[0]
+    k = min(int(args.nse_k), max(1, n - 1))
+    chunk = int(getattr(args, 'nse_chunk_size', 1024))
+    entropy_coeff = float(getattr(args, 'nse_entropy_coeff', 0.5))
+    eps = 1e-12
+    feats = F.normalize(features.float(), dim=1)
+    source = _normalize_rows(source_prior.float(), eps)
+    out = torch.zeros_like(source)
+    log_c = torch.log(torch.tensor(float(source.shape[1]), device=source.device))
+
+    for start in range(0, n, chunk):
+        end = min(n, start + chunk)
+        sim = feats[start:end] @ feats.t()
+        row_ids = torch.arange(start, end, device=sim.device)
+        sim[torch.arange(end - start, device=sim.device), row_ids] = -1e9
+        vals, idx = torch.topk(sim, k=k, dim=1, largest=True)
+        neigh = source[idx]
+        self_p = source[start:end].unsqueeze(1)
+        label_agree = (neigh * self_p).sum(dim=2).clamp_min(eps)
+        ent = -(neigh.clamp_min(eps) * neigh.clamp_min(eps).log()).sum(dim=2)
+        ent_weight = torch.exp(-entropy_coeff * ent / (log_c + eps))
+        spatial = torch.softmax(vals, dim=1)
+        weights = spatial * label_agree * ent_weight
+        weights = weights / (weights.sum(dim=1, keepdim=True) + eps)
+        out[start:end] = (weights.unsqueeze(2) * neigh).sum(dim=1)
+    return _normalize_rows(out, eps)
+
+
+@torch.no_grad()
+def nse_reliable_set_selection(args, epoch, sel_stats, train_givenY):
+    """Replace only PiCO+'s prototype-distance clean/noisy split.
+
+    Official PiCO+ stores clean/noisy state in ``sel_stats['is_rel']`` by
+    sorting prototype distances. Here we overwrite only that state using a
+    source-anchored topology selector. PiCO+'s losses, pseudo-target EMA,
+    prototypes, queues, MixUp, and unreliable guessed-target branch are left
+    unchanged by the patch.
+    """
+    device = sel_stats['is_rel'].device
+    seen = sel_stats.get('seen', torch.ones_like(sel_stats['is_rel'])).bool()
+    if seen.sum() < max(2, int(args.nse_k) + 1):
+        print('[SRSESplit] not enough stored features; keeping all samples reliable')
+        sel_stats['is_rel'] = torch.ones_like(sel_stats['is_rel']).bool()
+        return
+
+    features = sel_stats['features'].to(device)
+    source_prior = train_givenY.float().to(device)
+    source_prior = _normalize_rows(source_prior)
+    model_probs = sel_stats['model_probs'].to(device)
+    p_knn = _chunked_knn_votes(features, source_prior, args)
+
+    model_weight = float(getattr(args, 'nse_model_weight', 0.5))
+    if model_probs.sum() > 0 and model_weight > 0:
+        p_model = _normalize_rows(model_probs * source_prior)
+        scores = _normalize_rows((1.0 - model_weight) * p_knn + model_weight * p_model)
+    else:
+        scores = p_knn
+
+    max_p, max_idx = scores.max(dim=1)
+    in_source = source_prior.gather(1, max_idx.view(-1, 1)).view(-1) > 0
+    discrepancy = -torch.log(max_p.clamp_min(1e-12))
+    is_rel = torch.zeros_like(sel_stats['is_rel']).bool()
+    counts = torch.bincount(max_idx[in_source], minlength=args.num_class).float()
+    if counts.numel():
+        limit = torch.quantile(counts, float(getattr(args, 'nse_delta', 0.25)))
+    else:
+        limit = torch.tensor(0.0, device=device)
+
+    for c in range(args.num_class):
+        idx_c = torch.where(in_source & (max_idx == c))[0]
+        if idx_c.numel() == 0:
+            continue
+        k_c = min(int(limit.item()), idx_c.numel())
+        if k_c < 1:
+            continue
+        top = torch.topk(discrepancy[idx_c], k=k_c, largest=False).indices
+        is_rel[idx_c[top]] = True
+
+    if is_rel.sum() == 0:
+        fallback = min(max(1, int(0.01 * scores.shape[0])), scores.shape[0])
+        idx = torch.topk(max_p * in_source.float(), k=fallback, largest=True).indices
+        is_rel[idx] = True
+
+    sel_stats['is_rel'] = is_rel
+    print('[SRSESplit] epoch={} reliable={} total={} ratio={:.4f}'.format(
+        epoch, int(is_rel.sum().item()), int(is_rel.numel()), float(is_rel.float().mean().item())
+    ))
